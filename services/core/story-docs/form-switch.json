        "form-switch--sizes": {
          "id": "form-switch--sizes",
          "name": "Tamaños",
          "snippet": "<script lang=\"ts\" setup>\nimport { ref } from \"vue\";\nimport { GConfigProvider } from '@flash-global66/g-config-provider/index.ts';\nimport { GSwitch } from '@flash-global66/g-switch/index.ts';\n\nconst valueLarge = ref(true);\nconst valueDefault = ref(true);\nconst valueSmall = ref(true);\n</script>\n\n<template>\n  <g-config-provider>\n    <div class=\"space-y-4\">\n      <div class=\"flex items-center gap-4\">\n        <span class=\"w-16\">Large:</span>\n        <g-switch v-model=\"valueLarge\" size=\"large\" />\n      </div>\n      <div class=\"flex items-center gap-4\">\n        <span class=\"w-16\">Default:</span>\n        <g-switch v-model=\"valueDefault\" />\n      </div>\n      <div class=\"flex items-center gap-4\">\n        <span class=\"w-16\">Small:</span>\n        <g-switch v-model=\"valueSmall\" size=\"small\" />\n      </div>\n    </div>\n  </g-config-provider>\n</template>"
        },
        "form-switch--text-description": {
          "id": "form-switch--text-description",
          "name": "Descripción de texto",
          "snippet": "<script lang=\"ts\" setup>\nimport { ref } from \"vue\";\nimport { GConfigProvider } from '@flash-global66/g-config-provider/index.ts';\nimport { GSwitch } from '@flash-global66/g-switch/index.ts';\n\nconst value1 = ref(true);\nconst value2 = ref(true);\nconst value3 = ref(true);\nconst value4 = ref(true);\n</script>\n\n<template>\n  <g-config-provider>\n    <div class=\"space-y-4\">\n      <div class=\"flex items-center gap-4\">\n        <span class=\"w-32\">Con texto:</span>\n        <g-switch\n          v-model=\"value1\"\n          active-text=\"Pagar por año\"\n          inactive-text=\"Pagar por mes\"\n        />\n      </div>\n      <div class=\"flex items-center gap-4\">\n        <span class=\"w-32\">Inline prompt:</span>\n        <g-switch\n          v-model=\"value2\"\n          active-text=\"Pagar por año\"\n          inactive-text=\"Pagar por mes\"\n          inline-prompt\n          width=\"160px\"\n        />\n      </div>\n      <div class=\"flex items-center gap-4\">\n        <span class=\"w-32\">Texto corto:</span>\n        <g-switch\n          v-model=\"value3\"\n          active-text=\"On\"\n          inactive-text=\"Off\"\n          inline-prompt\n        />\n      </div>\n      <div class=\"flex items-center gap-4\">\n        <span class=\"w-32\">Solo activo:</span>\n        <g-switch\n          v-model=\"value4\"\n          active-text=\"Abierto\"\n          inline-prompt\n        />\n      </div>\n    </div>\n  </g-config-provider>\n</template>"
        },
        "form-switch--custom-icons": {
          "id": "form-switch--custom-icons",
          "name": "Iconos personalizados",
          "snippet": "<script lang=\"ts\" setup>\nimport { ref } from \"vue\";\nimport { GConfigProvider } from '@flash-global66/g-config-provider/index.ts';\nimport { GSwitch } from '@flash-global66/g-switch/index.ts';\n\nconst value1 = ref(true);\nconst value2 = ref(true);\nconst value3 = ref(true);\nconst value4 = ref(true);\n</script>\n\n<template>\n  <g-config-provider>\n    <div class=\"space-y-4\">\n      <div class=\"flex items-center gap-6\">\n        <span class=\"w-40 text-sm\">Aprobado/Rechazado:</span>\n        <g-switch\n          v-model=\"value1\"\n          active-icon=\"solid check\"\n          inactive-icon=\"solid times\"\n        />\n      </div>\n      <div class=\"flex items-center gap-6\">\n        <span class=\"w-40 text-sm\">Inline prompt:</span>\n        <g-switch\n          v-model=\"value2\"\n          active-icon=\"solid check\"\n          inactive-icon=\"solid times\"\n          inline-prompt\n        />\n      </div>\n      <div class=\"flex items-center gap-6\">\n        <span class=\"w-40 text-sm\">Tema claro/oscuro:</span>\n        <g-switch\n          v-model=\"value3\"\n          active-icon=\"solid lightbulb\"\n          inactive-icon=\"regular circle-xmark\"\n          inline-prompt\n        />\n      </div>\n      <div class=\"flex items-center gap-6\">\n        <span class=\"w-40 text-sm\">Visibilidad:</span>\n        <g-switch\n          v-model=\"value4\"\n          active-icon=\"regular eye\"\n          inactive-icon=\"regular eye-slash\"\n          inline-prompt\n        />\n      </div>\n    </div>\n  </g-config-provider>\n</template>"
        },
        "form-switch--extended-value-types": {
          "id": "form-switch--extended-value-types",
          "name": "Tipos de valor extendidos",
          "snippet": "<script lang=\"ts\" setup>\nimport { ref } from \"vue\";\nimport { GConfigProvider } from '@flash-global66/g-config-provider/index.ts';\nimport { GSwitch } from '@flash-global66/g-switch/index.ts';\n\nconst value1 = ref(100);\nconst value2 = ref('yes');\nconst value3 = ref(1);\n</script>\n\n<template>\n  <g-config-provider>\n    <div class=\"space-y-4\">\n      <div class=\"flex items-center gap-4\">\n        <span class=\"w-32\">Números:</span>\n        <g-switch\n          v-model=\"value1\"\n          :active-value=\"100\"\n          :inactive-value=\"0\"\n          active-text=\"100\"\n          inactive-text=\"0\"\n        />\n        <span class=\"text-sm\">Valor: {{ value1 }}</span>\n      </div>\n      <div class=\"flex items-center gap-4\">\n        <span class=\"w-32\">Strings:</span>\n        <g-switch\n          v-model=\"value2\"\n          active-value=\"yes\"\n          inactive-value=\"no\"\n          active-text=\"Sí\"\n          inactive-text=\"No\"\n        />\n        <span class=\"text-sm\">Valor: {{ value2 }}</span>\n      </div>\n      <div class=\"flex items-center gap-4\">\n        <span class=\"w-32\">Mixto:</span>\n        <g-switch\n          v-model=\"value3\"\n          :active-value=\"1\"\n          inactive-value=\"off\"\n          active-text=\"On\"\n          inactive-text=\"Off\"\n        />\n        <span class=\"text-sm\">Valor: {{ value3 }}</span>\n      </div>\n    </div>\n  </g-config-provider>\n</template>"
        },
        "form-switch--disabled": {
          "id": "form-switch--disabled",
          "name": "Deshabilitado",
          "snippet": "<script lang=\"ts\" setup>\nimport { ref } from \"vue\";\nimport { GConfigProvider } from '@flash-global66/g-config-provider/index.ts';\nimport { GSwitch } from '@flash-global66/g-switch/index.ts';\n\nconst value1 = ref(true);\nconst value2 = ref(false);\n</script>\n\n<template>\n  <g-config-provider>\n    <div class=\"space-y-4\">\n      <div class=\"flex items-center gap-4\">\n        <span class=\"w-32\">Deshabilitado ON:</span>\n        <g-switch v-model=\"value1\" disabled />\n      </div>\n      <div class=\"flex items-center gap-4\">\n        <span class=\"w-32\">Deshabilitado OFF:</span>\n        <g-switch v-model=\"value2\" disabled />\n      </div>\n      <div class=\"flex items-center gap-4\">\n        <span class=\"w-32\">Con texto:</span>\n        <g-switch\n          v-model=\"value1\"\n          disabled\n          active-text=\"Activo\"\n          inactive-text=\"Inactivo\"\n        />\n      </div>\n    </div>\n  </g-config-provider>\n</template>"
        },
        "form-switch--loading": {
          "id": "form-switch--loading",
          "name": "Estado de carga",
          "snippet": "<script lang=\"ts\" setup>\nimport { ref } from \"vue\";\nimport { GConfigProvider } from '@flash-global66/g-config-provider/index.ts';\nimport { GSwitch } from '@flash-global66/g-switch/index.ts';\n\nconst value1 = ref(true);\nconst value2 = ref(false);\n</script>\n\n<template>\n  <g-config-provider>\n    <div class=\"space-y-4\">\n      <div class=\"flex items-center gap-4\">\n        <span class=\"w-32\">Cargando ON:</span>\n        <g-switch v-model=\"value1\" loading />\n      </div>\n      <div class=\"flex items-center gap-4\">\n        <span class=\"w-32\">Cargando OFF:</span>\n        <g-switch v-model=\"value2\" loading />\n      </div>\n      <div class=\"flex items-center gap-4\">\n        <span class=\"w-32\">Con texto:</span>\n        <g-switch\n          v-model=\"value1\"\n          loading\n          active-text=\"Guardando...\"\n          inactive-text=\"Desconectado\"\n        />\n      </div>\n    </div>\n  </g-config-provider>\n</template>"
        },
        "form-switch--prevent-switching": {
