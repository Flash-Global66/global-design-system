          "snippet": "<script lang=\"ts\" setup>\nimport { ref } from \"vue\";\nimport { GButton } from '@flash-global66/g-button/index.ts';\nimport { GConfigProvider } from '@flash-global66/g-config-provider/index.ts';\nimport { GDrawer } from '@flash-global66/g-drawer/index.ts';\n\nconst drawer = ref(false);\n</script>\n\n<template>\n  <g-config-provider>\n    <g-button @click=\"drawer = true\">\n      Abrir drawer\n    </g-button>\n    <g-drawer v-model=\"drawer\" appendTo=\"body\" appendToBody :closeDelay=\"0\" closeOnClickModal closeOnPressEscape description=\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.\" :destroyOnClose=\"false\" direction=\"rtl\" lockScroll modal modalFade :openDelay=\"0\" showClose size=\"400px\" title=\"Title\" withHeader :zIndex=\"10\">\n      <span>Contenido personalizado!</span>\n    </g-drawer>\n  </g-config-provider>\n</template>",
