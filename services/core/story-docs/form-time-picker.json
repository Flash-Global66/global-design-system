          "id": "form-time-picker--range",
          "name": "Modo Rango",
          "snippet": "<script lang=\"ts\" setup>\nimport { ref } from \"vue\";\nimport { GConfigProvider } from '../components/config-provider';\nimport { GTimePicker } from '../components/time-picker';\n\nconst value = ref([]);\n</script>\n\n<template>\n  <g-config-provider>\n    <div class=\"flex flex-col gap-4\">\n      <g-time-picker\n        v-model=\"value\"\n        is-range\n        start-placeholder=\"Hora inicio\"\n        end-placeholder=\"Hora fin\"\n        label=\"Seleccione rango\"\n        range-separator=\"|\"\n        format=\"HH:mm:ss\"\n      />\n      <div>Rango seleccionado: {{ value }}</div>\n    </div>\n  </g-config-provider>\n</template>"
