        "form-time-picker--custom-format": {
          "id": "form-time-picker--custom-format",
          "name": "Formato Personalizado",
          "snippet": "<script lang=\"ts\" setup>\nimport { ref } from \"vue\";\nimport { GConfigProvider } from '../components/config-provider';\nimport { GTimePicker } from '../components/time-picker';\n\nconst value = ref('');\nconst format = 'hh:mm A';\nconst valueFormat = 'HH:mm:ss';\n</script>\n\n<template>\n  <g-config-provider>\n    <div class=\"flex flex-col gap-4\">\n      <div class=\"grid grid-cols-2 gap-4\">\n        <g-time-picker\n          v-model=\"value\"\n          :format=\"format\"\n          :value-format=\"valueFormat\"\n          label=\"Ej: 02:30 PM\"\n        />\n        <div>\n          <p>Valor mostrado: {{ value }}</p>\n        </div>\n      </div>\n    </div>\n  </g-config-provider>\n</template>"
        },
