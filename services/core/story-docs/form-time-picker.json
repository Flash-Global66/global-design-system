          "name": "Básico",
          "snippet": "<script lang=\"ts\" setup>\nimport { ref } from \"vue\";\nimport { GConfigProvider } from '../components/config-provider';\nimport { GTimePicker } from '../components/time-picker';\n\nconst value = ref('');\n</script>\n\n<template>\n  <g-config-provider>\n    <div class=\"flex flex-col gap-4\">\n      <g-time-picker clearable endPlaceholder=\"Hora fin\" format=\"HH:mm:ss\" label=\"Seleccione hora\" startPlaceholder=\"Hora inicio\" v-model=\"value\" />\n    </div>\n  </g-config-provider>\n</template>"
        },
