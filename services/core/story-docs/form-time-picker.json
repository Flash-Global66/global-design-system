          "id": "form-time-picker--states",
          "name": "Estados",
          "snippet": "<script lang=\"ts\" setup>\nimport { ref } from \"vue\";\nimport { GConfigProvider } from '../components/config-provider';\nimport { GTimePicker } from '../components/time-picker';\n\nconst time = ref('');\nconst timeDisabled = ref('');\nconst timeHelpText = ref('');\n</script>\n\n<template>\n  <g-config-provider>\n    <div class=\"flex flex-col gap-4\">\n      <g-time-picker\n        class=\"my-2\"\n        v-model=\"time\"\n        label=\"Normal\"\n      />\n\n      <g-time-picker\n        v-model=\"timeDisabled\"\n        label=\"Deshabilitado\"\n        disabled\n      />\n\n      <g-time-picker\n        v-model=\"timeHelpText\"\n        label=\"Texto con error\"\n        messageError=\"Debe ser mayor de 18 años\"\n      />\n    </div>\n  </g-config-provider>\n</template>"
