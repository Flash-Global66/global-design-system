          "snippet": "<script lang=\"ts\" setup>\nimport { GConfigProvider } from '../components/config-provider';\nimport { GScrollbar } from '../components/scrollbar/index.ts';\n</script>\n\n<template>\n  <g-config-provider>\n    <g-scrollbar :always=\"false\" :minSize=\"20\" :noresize=\"false\" tag=\"div\" style=\"height: 300px\" native>\n      <div v-for=\"item in 20\" :key=\"item\" style=\"padding: 12px 0\">\n        {{ item }} - Contenido con scrollbar nativo\n      </div>\n    </g-scrollbar>\n  </g-config-provider>\n</template>"
