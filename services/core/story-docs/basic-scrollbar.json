          "name": "Primary",
          "snippet": "<script lang=\"ts\" setup>\nimport { GConfigProvider } from '../components/config-provider';\nimport { GScrollbar } from '../components/scrollbar/index.ts';\n</script>\n\n<template>\n  <g-config-provider>\n    <g-scrollbar :always=\"false\" :minSize=\"20\" :native=\"false\" :noresize=\"false\" tag=\"div\" style=\"height: 300px\">\n      <div v-for=\"item in 20\" :key=\"item\" style=\"padding: 12px 0\">\n        {{ item }} - Contenido de ejemplo para el scrollbar\n      </div>\n    </g-scrollbar>\n  </g-config-provider>\n</template>"
        },
