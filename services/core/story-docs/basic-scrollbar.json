          "snippet": "<script lang=\"ts\" setup>\nimport { GConfigProvider } from '../components/config-provider';\nimport { GScrollbar } from '../components/scrollbar/index.ts';\n</script>\n\n<template>\n  <g-config-provider>\n    <g-scrollbar :always=\"false\" :minSize=\"20\" :native=\"false\" :noresize=\"false\" tag=\"div\" style=\"height: 100px; width: 300px\">\n      <div style=\"width: 800px; white-space: nowrap;\">\n        <div v-for=\"item in 20\" :key=\"item\" style=\"display: inline-block; padding: 12px;\">\n          Item {{ item }}\n        </div>\n      </div>\n    </g-scrollbar>\n  </g-config-provider>\n</template>"
